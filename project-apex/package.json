{
  "name": "project-apex",
  "private": true,
  "version": "1.0.0",
  "description": "PROJECT APEX: a motorsport team management simulator. Take a Formula 5 backmarker all the way to Formula 1.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
